@page
@model Disable2faModel
@{
    ViewData["Title"] = "Desactivar autenticación de dos factores";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Esta acción solo desactiva la autenticación de dos factores.</strong>
    </p>
    <p>
        Desactivar la autenticación de dos factores no cambia las claves de tu aplicación. Para cambiar la clave
        de la aplicación debes <a asp-page="./ResetAuthenticator">restablecer las claves de autenticación.</a>
    </p>
</div>

<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Desactivar dos factores</button>
    </form>
</div>
