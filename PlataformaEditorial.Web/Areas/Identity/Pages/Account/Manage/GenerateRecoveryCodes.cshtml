@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generar códigos de recuperación de dos factores";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Guarda estos códigos en un lugar seguro.</strong>
    </p>
    <p>
        Si pierdes tu dispositivo y no conservas los códigos de recuperación, perderás el acceso a tu cuenta.
    </p>
    <p>
        Generar códigos de recuperación no cambia las claves de tu aplicación. Para cambiar la clave
        de la aplicación debes <a asp-page="./ResetAuthenticator">restablecer las claves de autenticación.</a>
    </p>
</div>
<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Generar códigos de recuperación</button>
    </form>
</div>
