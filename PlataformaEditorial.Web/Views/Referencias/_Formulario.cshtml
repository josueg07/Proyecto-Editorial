@model ReferenciaEdicion
@{ var tipo=(TipoReferencia)ViewData["Tipo"]!; }
<form method="post" class="formulario-catalogo">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" maxlength="@(tipo==TipoReferencia.Formatos?50:tipo==TipoReferencia.Categorias?100:150)" /><span asp-validation-for="Nombre" class="text-danger"></span></div>
    @if(tipo is TipoReferencia.Autores or TipoReferencia.Categorias) { <div class="form-check mb-3"><input asp-for="Activo" class="form-check-input" /><label asp-for="Activo" class="form-check-label"></label></div> }
    @if(tipo==TipoReferencia.Formatos) { <div class="form-check mb-3"><input asp-for="EsDigital" class="form-check-input" /><label asp-for="EsDigital" class="form-check-label"></label></div> }
    <button class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</form>

