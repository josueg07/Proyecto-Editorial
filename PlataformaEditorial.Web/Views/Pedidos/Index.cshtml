@using PlataformaEditorial.Web.Models.Compras

@model List<PedidoFila>
@{ViewData["Title"]=User.IsInRole("Administrador")?"Gestión de pedidos":"Mis pedidos";}
<h1>@ViewData["Title"]</h1>
@if(Model.Count==0) { <p>No hay pedidos para mostrar.</p> }
<div class="table-responsive"><table class="table"><thead><tr><th>Pedido</th><th>Fecha</th><th>Estado</th><th>Total</th><th></th></tr></thead><tbody>
@foreach(var p in Model) { <tr><td>PED-@p.Id.ToString("D6")</td><td>@p.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td>@p.Estado</td><td>Q @p.Total.ToString("N2")</td><td><a asp-action="Detalles" asp-route-id="@p.Id">Ver detalle</a></td></tr> }
</tbody></table></div>
