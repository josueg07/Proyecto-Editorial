@model string
@if(User.IsInRole("ClienteMinorista") || User.IsInRole("ClienteInstitucional"))
{
    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Carrito" asp-action="Index">Carrito</a></li>
    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Pedidos" asp-action="Index">Mis pedidos</a></li>
    <li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Instituciones</a><ul class="dropdown-menu">
        <li><a class="dropdown-item" asp-area="" asp-controller="PerfilInstitucional" asp-action="Index">@(Model==""?"Solicitar perfil institucional":$"Perfil institucional: {Model}")</a></li>
        @if(User.IsInRole("ClienteInstitucional") && Model=="Aprobado")
        {
            <li><a class="dropdown-item" asp-area="" asp-controller="SolicitudesInstitucionales" asp-action="Nueva">Nueva solicitud de cotización</a></li>
            <li><a class="dropdown-item" asp-area="" asp-controller="SolicitudesInstitucionales" asp-action="Index">Mis solicitudes y cotizaciones</a></li>
        }
    </ul></li>
}
@if(User.IsInRole("AsesorVentas"))
{
    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="SolicitudesInstitucionales" asp-action="Index">Solicitudes asignadas y cotizaciones</a></li>
}
@if(User.IsInRole("Administrador"))
{
    <li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administración</a><ul class="dropdown-menu">
    @foreach(var c in new[]{"Administracion","Libros","Autores","Categorias","Editoriales","Formatos","Presentaciones","PerfilesInstitucionales","SolicitudesInstitucionales","Pedidos"})
    { <li><a class="dropdown-item" asp-area="" asp-controller="@c" asp-action="Index">@(c switch {"Administracion"=>"Panel administrativo","Categorias"=>"Categorías","PerfilesInstitucionales"=>"Validar perfiles institucionales","SolicitudesInstitucionales"=>"Asignar y supervisar solicitudes","Pedidos"=>"Gestionar pedidos",_=>c})</a></li> }
    </ul></li>
}
