@model List<TarjetaLibro>
@if(Model.Count==0) { <p class="alert alert-info">No hay libros para mostrar.</p> }
<div class="row g-4 mb-4">
@foreach(var libro in Model)
{
    <div class="col-sm-6 col-lg-4"><article class="card h-100">
        <img src="@libro.Portada" class="card-img-top portada-catalogo" alt="Portada de @libro.Titulo" loading="lazy" />
        <div class="card-body d-flex flex-column">
            <h3 class="h5"><a asp-controller="Catalogo" asp-action="Detalles" asp-route-id="@libro.Id">@libro.Titulo</a></h3>
            <p>@(string.IsNullOrEmpty(libro.Autores)?"Sin autores activos registrados":libro.Autores)</p>
            <p class="text-muted">@libro.Editorial</p>
            <p>@libro.Formatos</p>
            <p class="fw-bold mt-auto">@(libro.Precio.HasValue ? $"Desde Q {libro.Precio.Value:N2} (antes de IVA)" : "Sin presentaciones registradas")</p>
        </div>
    </article></div>
}
</div>
