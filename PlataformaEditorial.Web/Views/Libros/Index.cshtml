@model List<tblLibro>
@{ ViewData["Title"]="Libros"; }
<h1>Libros</h1>
<p><a asp-controller="Administracion" asp-action="Index">Administración</a> · <a asp-action="Crear" class="btn btn-primary">Crear libro</a> <a asp-controller="Presentaciones" asp-action="Index" class="btn btn-outline-primary">Presentaciones</a></p>
<div class="table-responsive"><table class="table"><thead><tr><th>Título</th><th>Editorial</th><th>Activo</th><th>Destacado</th><th>Acciones</th></tr></thead><tbody>
@foreach(var l in Model) { <tr><td>@l.Titulo</td><td>@l.IDEditorialNavigation.NombreEditorial</td><td>@(l.Activo?"Sí":"No")</td><td>@(l.Destacado?"Sí":"No")</td><td><a asp-action="Editar" asp-route-id="@l.IDLibro">Editar</a> · <a asp-action="Eliminar" asp-route-id="@l.IDLibro">Desactivar</a> @if(l.Activo) { <span> · </span><a asp-controller="Catalogo" asp-action="Detalles" asp-route-id="@l.IDLibro">Ver</a> }</td></tr> }
</tbody></table></div>
@if(Model.Count==0) { <p>No hay libros registrados.</p> }
