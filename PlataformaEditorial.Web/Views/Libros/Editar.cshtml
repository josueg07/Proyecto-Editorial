@model LibroEdicion
@{ ViewData["Title"]=Model.Id==0?"Crear libro":"Editar libro"; }
<h1>@ViewData["Title"]</h1>
<form method="post" class="formulario-catalogo">
    <div asp-validation-summary="All" class="text-danger"></div><input type="hidden" asp-for="Id" />
    <div class="mb-3"><label asp-for="Titulo" class="form-label"></label><input asp-for="Titulo" class="form-control" /><span asp-validation-for="Titulo" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Sinopsis" class="form-label"></label><textarea asp-for="Sinopsis" rows="5" class="form-control"></textarea><span asp-validation-for="Sinopsis" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="AnioEdicion" class="form-label"></label><input asp-for="AnioEdicion" class="form-control" /><span asp-validation-for="AnioEdicion" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="PortadaUrl" class="form-label"></label><input asp-for="PortadaUrl" class="form-control" /><span asp-validation-for="PortadaUrl" class="text-danger"></span><small>URL https o ruta dentro de /images/. Portada predeterminada: /images/sin-portada.svg.</small></div>
    <div class="mb-3"><label asp-for="EditorialId" class="form-label"></label><select asp-for="EditorialId" asp-items="Model.Editoriales" class="form-select"><option value="">Seleccione una editorial</option></select><span asp-validation-for="EditorialId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="AutoresIds" class="form-label"></label><select asp-for="AutoresIds" asp-items="Model.Autores" multiple size="5" class="form-select"></select></div>
    <div class="mb-3"><label asp-for="CategoriasIds" class="form-label"></label><select asp-for="CategoriasIds" asp-items="Model.Categorias" multiple size="5" class="form-select"></select><small>Use Ctrl para seleccionar varias opciones. Las opciones inactivas se conservan, pero no se muestran al público.</small></div>
    <div class="form-check mb-3"><input asp-for="Activo" class="form-check-input" /><label asp-for="Activo" class="form-check-label"></label></div>
    <div class="form-check mb-3"><input asp-for="Destacado" class="form-check-input" /><label asp-for="Destacado" class="form-check-label"></label></div>
    <button class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
