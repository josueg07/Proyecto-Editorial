@model List<tblPresentacionLibro>
@{ ViewData["Title"]="Presentaciones de libros"; }
<h1>@ViewData["Title"]</h1>
<p><a asp-controller="Administracion" asp-action="Index">Administración</a> · <a asp-action="Crear" class="btn btn-primary">Crear presentación</a></p>
<div class="table-responsive"><table class="table"><thead><tr><th>Libro</th><th>Formato</th><th>ISBN</th><th>Precio base</th><th>Existencias</th><th>Acciones</th></tr></thead><tbody>
@foreach(var p in Model) { <tr><td>@p.IDLibroNavigation.Titulo</td><td>@p.IDFormatoNavigation.NombreFormato</td><td>@p.isbn</td><td>Q @p.PrecioBase.ToString("N2")</td><td>@(p.Existencias?.ToString()??"Sin dato")</td><td><a asp-action="Editar" asp-route-id="@p.IDPresentacion">Editar</a> · <a asp-action="Eliminar" asp-route-id="@p.IDPresentacion">Eliminar</a></td></tr> }
</tbody></table></div>
@if(Model.Count==0) { <p>No hay presentaciones registradas.</p> }
